{%- props
    ## number Delay in milliseconds before showing the sub-menu.
    openDelay = 0,
    ## number Delay in milliseconds before hiding the sub-menu.
    closeDelay = 0
-%}
<div
    data-slot="dropdown-menu-sub"
    data-tstdt--dropdown-menu-sub-open-delay-value="{{ openDelay }}"
    data-tstdt--dropdown-menu-sub-close-delay-value="{{ closeDelay }}"
    {{ attributes.without('class').defaults({
        'data-controller': 'tstdt--dropdown-menu-sub',
        'data-action': 'mouseenter->tstdt--dropdown-menu-sub#show mouseleave->tstdt--dropdown-menu-sub#hide',
    }) }}
    class="{{ ('relative ' ~ attributes.render('class'))|tailwind_merge }}"
>
    {##- A `DropdownMenu:SubTrigger` and a `DropdownMenu:SubContent`. -#}
    {%- block content %}{% endblock -%}
</div>
