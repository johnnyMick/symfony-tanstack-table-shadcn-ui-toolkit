{%- props
    ## string Unique id used to wire `Sidebar:Trigger` and `Sidebar:Rail` to the right provider. Auto-generated when omitted.
    id = null,
    ## boolean Initial open state when no cookie is present.
    defaultOpen = true,
    ## string Cookie used to persist the sidebar state across reloads (empty disables persistence).
    cookieName = 'sidebar:state',
    ## int Cookie max-age, in seconds.
    cookieMaxAge = 604800,
    ## int Pixel width below which the sidebar behaves as an off-canvas sheet.
    mobileBreakpoint = 768,
    ## string Single key combined with Ctrl/Cmd that toggles the sidebar; empty disables the shortcut.
    keyboardShortcut = 'b'
-%}
{%- set _sidebar_provider_id = id ?? ('sidebar-provider-' ~ random()) -%}
{%- do provide('sidebar.id', _sidebar_provider_id) -%}
{%- do provide('sidebar.defaultOpen', defaultOpen) -%}
<div
    id="{{ _sidebar_provider_id }}"
    data-slot="sidebar-provider"
    data-tstdt--sidebar-default-open-value="{{ defaultOpen ? 'true' : 'false' }}"
    data-tstdt--sidebar-cookie-name-value="{{ cookieName }}"
    data-tstdt--sidebar-cookie-max-age-value="{{ cookieMaxAge }}"
    data-tstdt--sidebar-mobile-breakpoint-value="{{ mobileBreakpoint }}"
    data-tstdt--sidebar-keyboard-shortcut-value="{{ keyboardShortcut }}"
    data-state="{{ defaultOpen ? 'expanded' : 'collapsed' }}"
    {{ attributes.without('class').defaults({
        'data-controller': 'tstdt--sidebar',
        'data-action': 'keydown@window->tstdt--sidebar#handleKeydown',
        style: '--sidebar-width: 16rem; --sidebar-width-icon: 3rem; --sidebar-width-mobile: 18rem;',
    }) }}
    class="{{ ('group/sidebar-wrapper flex min-h-svh w-full has-[[data-variant=inset]]:bg-sidebar ' ~ attributes.render('class'))|tailwind_merge }}"
>
    {##- Typically a `Sidebar` and a `Sidebar:Inset` (with one or more `Sidebar:Trigger` inside). -#}
    {%- block content %}{% endblock -%}
</div>
