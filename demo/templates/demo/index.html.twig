{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
    <twig:tstdt_AdminLayout>
        <twig:block name="title">Dashboard</twig:block>

        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {% set cards = [
                {label: 'Products', count: counts.product|default(0), route: 'app_catalog_products', icon: 'lucide:package'},
                {label: 'Categories', count: counts.category|default(0), route: 'app_catalog_categories', icon: 'lucide:tags'},
                {label: 'Orders', count: counts.shop_order|default(0), route: 'app_sales_orders', icon: 'lucide:shopping-cart'},
                {label: 'Customers', count: counts.customer|default(0), route: 'app_sales_customers', icon: 'lucide:users'},
                {label: 'Order items', count: counts.order_item|default(0), route: 'app_sales_order_items', icon: 'lucide:list-ordered'},
            ] %}
            {% for card in cards %}
                <a href="{{ path(card.route) }}" class="block transition-opacity hover:opacity-90">
                    <twig:tstdt_Card>
                        <twig:tstdt_Card:Header>
                            <twig:tstdt_Card:Title class="flex items-center gap-2">
                                <twig:ux:icon name="{{ card.icon }}" class="size-4 text-muted-foreground" aria-hidden="true" />
                                {{ card.label }}
                            </twig:tstdt_Card:Title>
                            <twig:tstdt_Card:Description>Open the {{ card.label|lower }} table</twig:tstdt_Card:Description>
                        </twig:tstdt_Card:Header>
                        <twig:tstdt_Card:Content>
                            <p class="text-3xl font-semibold tracking-tight">{{ card.count|number_format }}</p>
                        </twig:tstdt_Card:Content>
                    </twig:tstdt_Card>
                </a>
            {% endfor %}
        </div>

        <twig:tstdt_Card>
            <twig:tstdt_Card:Header>
                <twig:tstdt_Card:Title>Getting started</twig:tstdt_Card:Title>
                <twig:tstdt_Card:Description>
                    Use the sidebar to browse catalog and sales tables. Reset seed data under Settings → Demo data.
                </twig:tstdt_Card:Description>
            </twig:tstdt_Card:Header>
            <twig:tstdt_Card:Content class="text-sm text-muted-foreground">
                <a href="{{ path('app_settings_demo_data') }}" class="text-primary underline-offset-4 hover:underline">Manage demo data</a>
            </twig:tstdt_Card:Content>
        </twig:tstdt_Card>
    </twig:tstdt_AdminLayout>
{% endblock %}
