{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
    <div class="flex min-h-svh items-center justify-center bg-muted/40 p-4">
        <div class="w-full max-w-sm rounded-xl border border-border bg-background p-6 shadow-sm">
            <div class="mb-6 space-y-1">
                <h1 class="text-xl font-semibold tracking-tight">Sign in</h1>
                <p class="text-sm text-muted-foreground">
                    Sales pages require an authenticated demo user.
                </p>
            </div>

            {% if error %}
                <div class="mb-4 rounded-lg border border-destructive/30 bg-destructive/10 px-3 py-2 text-sm text-destructive" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post" class="space-y-4" novalidate>
                <div class="space-y-1.5">
                    <label for="username" class="text-sm font-medium">Username</label>
                    <twig:tstdt:Input
                        id="username"
                        type="text"
                        name="_username"
                        value="{{ last_username }}"
                        autocomplete="username"
                        required
                        autofocus
                    />
                </div>

                <div class="space-y-1.5">
                    <label for="password" class="text-sm font-medium">Password</label>
                    <twig:tstdt:Input
                        id="password"
                        type="password"
                        name="_password"
                        autocomplete="current-password"
                        required
                    />
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <twig:tstdt:Button type="submit" class="w-full">
                    Sign in
                </twig:tstdt:Button>
            </form>

            <p class="mt-4 text-xs text-muted-foreground">
                Demo credentials: <span class="font-mono text-foreground">admin</span> /
                <span class="font-mono text-foreground">admin</span>
            </p>

            <p class="mt-3 text-center text-sm">
                <a href="{{ path('app_demo') }}" class="text-primary underline-offset-4 hover:underline">Back to dashboard</a>
            </p>
        </div>
    </div>
{% endblock %}
